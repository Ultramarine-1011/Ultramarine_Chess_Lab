# Retained experiment hashes are over exact bytes on every platform.
* text=auto eol=lf
*.gz binary
*.zst binary
# R5 Windows tool output is research evidence: preserve bytes hashed at runtime.
experiments/results/r5-*/** -text
docs/validation/r5/*.json -text
docs/validation/r5/*.log -text
# R6 manifests identify the exact produced research bytes.
experiments/results/r6-*/** -text
docs/validation/r6/*.log -text
